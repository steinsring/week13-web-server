-static int allocate_loop_resources(Loop* loop, size_t limit)
-{
-    loop->epoll = -1;
-    loop->wake = -1;
-    /* 요청별 upstream 버퍼까지 포함한 크기 계산이 넘치지 않아야 한다. */
