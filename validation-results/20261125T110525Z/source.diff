-/* 아직 헤더를 한 바이트도 보내지 않았을 때만 종료 표시를 덧붙일 수 있다. */
-static int mark_shutdown_response(Connection* connection)
-{
-    connection->close_after_response = 1;
-    if (connection->proxy)
